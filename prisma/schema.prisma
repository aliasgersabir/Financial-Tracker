generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Core Models
// ============================================================

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String           @unique
  emailVerified    DateTime?
  password         String
  image            String?
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  budgets          Budget[]
  goals            Goal[]
  recurringRules   RecurringRule[]
  importJobs       ImportJob[]
  calendarEvents   CalendarEvent[]
  notifications    Notification[]
  reports          Report[]
  tags             Tag[]
  receipts         Receipt[]
  subscriptions    Subscription[]
  forecasts        Forecast[]
  aiInsights       AIInsight[]
  insightHistory   InsightHistory[]
  healthSnapshots  FinancialHealthSnapshot[]
  scenarioAnalyses ScenarioAnalysis[]
  cashFlowProjections CashFlowProjection[]
  learningRules    LearningCategoryRule[]
  scenarioPlans    ScenarioPlan[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Account {
  id              String           @id @default(cuid())
  name            String
  type            String           @default("checking")
  balance         Float            @default(0)
  currency        String           @default("USD")
  color           String           @default("#6366f1")
  icon            String?
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  calendarEvents  CalendarEvent[]
  importJobs      ImportJob[]
  recurringRules  RecurringRule[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Category {
  id              String           @id @default(cuid())
  name            String
  type            String           @default("expense")
  icon            String           @default("📦")
  color           String           @default("#6366f1")
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  budgetItems     BudgetItem[]
  calendarEvents  CalendarEvent[]
  recurringRules  RecurringRule[]
  subscriptions   Subscription[]
  learningRules   LearningCategoryRule[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([name, userId, type])
}

model Transaction {
  id              String           @id @default(cuid())
  amount          Float
  description     String
  date            DateTime         @default(now())
  type            String           @default("expense")
  accountId       String
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringRuleId String?
  recurringRule   RecurringRule?   @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  subscriptionId  String?
  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  tags            TransactionTag[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ============================================================
// Budget Management
// ============================================================

model Budget {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  month     Int
  year      Int
  items     BudgetItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, month, year])
}

model BudgetItem {
  id         String   @id @default(cuid())
  budgetId   String
  budget     Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([budgetId, categoryId])
}

// ============================================================
// Savings Goals
// ============================================================

model Goal {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  targetAmount    Float
  currentSaved    Float              @default(0)
  deadline        DateTime?
  monthlyTarget   Float?
  notes           String?
  icon            String             @default("🎯")
  color           String             @default("#2563EB")
  status          String             @default("active")
  contributions   GoalContribution[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model GoalContribution {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
}

// ============================================================
// Recurring Transactions
// ============================================================

model RecurringRule {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount          Float
  description     String
  type            String        @default("expense")
  frequency       String
  interval        Int           @default(1)
  startDate       DateTime
  endDate         DateTime?
  nextRunDate     DateTime
  lastRunDate     DateTime?
  isActive        Boolean       @default(true)
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ============================================================
// Statement Import
// ============================================================

model ImportJob {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileName      String
  fileType      String
  status        String        @default("pending")
  totalRows     Int           @default(0)
  importedRows  Int           @default(0)
  skippedRows   Int           @default(0)
  duplicateRows Int           @default(0)
  errorMessage  String?
  rows          ImportRow[]
  createdAt     DateTime      @default(now())
  completedAt   DateTime?
}

model ImportRow {
  id                  String    @id @default(cuid())
  jobId               String
  job                 ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  date                DateTime
  description         String
  amount              Float
  type                String
  balance             Float?
  merchantName        String?
  suggestedCategoryId String?
  status              String    @default("new")
  createdAt           DateTime  @default(now())
}

// ============================================================
// Calendar Events
// ============================================================

model CalendarEvent {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  amount             Float?
  accountId          String?
  account            Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date               DateTime
  endDate            DateTime?
  type               String    @default("custom")
  recurrence         String    @default("none")
  recurrenceInterval Int       @default(1)
  reminderBefore     Int?
  isCompleted        Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ============================================================
// Notifications
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  metadata  String?
  createdAt DateTime @default(now())
}

// ============================================================
// Reports
// ============================================================

model Report {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  period    String
  startDate DateTime
  endDate   DateTime
  data      String
  createdAt DateTime @default(now())
}

// ============================================================
// Tags
// ============================================================

model Tag {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String           @default("#6B7280")
  transactions TransactionTag[]
  createdAt    DateTime         @default(now())

  @@unique([name, userId])
}

model TransactionTag {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

// ============================================================
// Phase 3 — Receipt OCR
// ============================================================

model Receipt {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName        String
  fileType        String
  fileUrl         String?
  merchantName    String?
  totalAmount     Float?
  taxAmount       Float?
  date            DateTime?
  rawText         String?
  status          String           @default("pending")
  ocrExtraction   OCRExtraction?
  transactionId   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model OCRExtraction {
  id              String   @id @default(cuid())
  receiptId       String   @unique
  receipt         Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  merchant        String?
  date            DateTime?
  subtotal        Float?
  tax             Float?
  total           Float?
  items           String?
  confidence      Float?
  rawResponse     String?
  createdAt       DateTime @default(now())
}

// ============================================================
// Phase 3 — Subscription Intelligence
// ============================================================

model Subscription {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  amount          Float
  currency        String        @default("USD")
  frequency       String        @default("monthly")
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  nextRenewal     DateTime?
  startDate       DateTime      @default(now())
  endDate         DateTime?
  isActive        Boolean       @default(true)
  isTrial         Boolean       @default(false)
  website         String?
  notes           String?
  autoDetected    Boolean       @default(false)
  paymentMethod   String?
  color           String        @default("#6B7280")
  transactions    Transaction[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ============================================================
// Phase 3 — Financial Forecasting
// ============================================================

model Forecast {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  period          String
  startDate       DateTime
  endDate         DateTime
  data            String
  accuracy        Float?
  generatedAt     DateTime @default(now())
}

// ============================================================
// Phase 3 — AI Insights
// ============================================================

model AIInsight {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  title           String
  explanation     String
  action          String?
  category        String?
  priority        String          @default("medium")
  confidence      Float?
  isRead          Boolean         @default(false)
  isDismissed     Boolean         @default(false)
  metadata        String?
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
}

model InsightHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightType     String
  insightTitle    String
  action          String?
  createdAt       DateTime @default(now())
}

// ============================================================
// Phase 3 — Financial Health Score
// ============================================================

model FinancialHealthSnapshot {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score           Int
  savingsRate     Float?
  budgetDiscipline Float?
  goalProgress    Float?
  emergencyFund   Float?
  spendingConsistency Float?
  debtRatio       Float?
  breakdown       String?
  snapshotDate    DateTime @default(now())
}

// ============================================================
// Phase 3 — Scenario Analysis
// ============================================================

model ScenarioAnalysis {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  assumptions     String
  results         String?
  isFavorite      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// Phase 3 — Cash Flow Projections
// ============================================================

model CashFlowProjection {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime
  type            String
  description     String?
  amount          Float
  category        String?
  isRecurring     Boolean  @default(false)
  isConfirmed     Boolean  @default(false)
  createdAt       DateTime @default(now())
}

// ============================================================
// Phase 3 — Smart Categorization Rules
// ============================================================

model LearningCategoryRule {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern         String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  matchType       String   @default("contains")
  priority        Int      @default(0)
  timesApplied    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================
// Phase 3 — Scenario Planner
// ============================================================

model ScenarioPlan {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  assumptions     String
  projections     String?
  isFavorite      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}
